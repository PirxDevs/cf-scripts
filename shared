cf_api() {
  local method="$1"
  local endpoint="$2"
  local data="${3:-}"
  local response success

  response=$(curl -s -X "${method}" "${api_url}/${endpoint}" \
    -H "Authorization: Bearer ${api_token}" \
    -H "Content-Type: application/json" \
    ${data:+-d "${data}"})

  echo "${response}"
  if [ $(echo "${response}" | jq -r '.success') != "true" ]; then
    return 1
  fi
  return 0
}

error_out() {
  error_code=$(echo "$@" | jq -r '.errors[0]["code"]')
  error_message=$(echo "$@" | jq -r '.errors[0]["message"]')
  echo "Error ${error_code} while querying API: ${error_message}"
}

bail_out() {
  error_out $@
  exit 1
}

if test -f "${script_dir}/config"; then
  . "${script_dir}/config"
else
  echo "Config file not found or not readable"
  exit 1
fi

jq --help 1>/dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "Error: command 'jq' not available. Please install jq."
  exit 1
fi

if [ -z "${api_url}" ]; then
  echo "Error: API URL must be specified in ${script_dir}/config"
  exit 1
fi

if [ -z "${api_token}" ]; then
  echo "Error: API token must be specified in ${script_dir}/config"
  exit 1
fi

if declare -F "usage" >/dev/null; then
  if [ $# -eq 0 ]; then
    usage
    exit 0
  fi
fi
